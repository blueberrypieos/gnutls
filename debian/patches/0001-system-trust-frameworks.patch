Description: Use the system trust frameworks only where they are available
 configure checks for the Security and CoreFoundation frameworks.
 lib/system/certs.c uses them to read the system trust store. Without
 them, the library reads the trust store file given with
 --with-default-trust-store-file.
Author: The Blueberry Pie OS Authors
Forwarded: not-needed
Last-Update: 2026-11-25
---
--- a/configure.ac
+++ b/configure.ac
@@ -1,5 +1,6 @@
 dnl Process this file with autoconf to produce a configure script.
 # Copyright (C) 2000-2012, 2016, 2019, 2022 Free Software Foundation, Inc.
+# Modified 2026-11-04: Detect available system trust frameworks (GPL-3.0 section 5(a)).
 #
 # Author: Nikos Mavrogiannopoulos, Simon Josefsson
 #
@@ -150,7 +151,20 @@ case "$host" in
     AC_MSG_CHECKING([whether the linker supports -Wl,-no_weak_imports])
     AC_LINK_IFELSE([AC_LANG_PROGRAM([], [])],
       [AC_MSG_RESULT(yes)], [AC_MSG_RESULT(no); LDFLAGS="$save_LDFLAGS"])
-    GNUTLS_LIBS_PRIVATE="${GNUTLS_LIBS_PRIVATE} -framework Security -framework CoreFoundation"
+    AC_CHECK_HEADERS([Security/Security.h])
+    AS_IF([test "$ac_cv_header_Security_Security_h" = yes], [
+      save_LIBS="$LIBS"
+      LIBS="$LIBS -framework Security -framework CoreFoundation"
+      AC_LINK_IFELSE([AC_LANG_PROGRAM([[#include <Security/Security.h>]],
+        [[CFArrayRef certs = NULL;
+          return SecTrustSettingsCopyCertificates(kSecTrustSettingsDomainSystem, &certs);]])],
+        [have_system_trust_frameworks=yes])
+      LIBS="$save_LIBS"
+    ])
+    AS_IF([test "$have_system_trust_frameworks" = yes], [
+      AC_DEFINE([HAVE_SYSTEM_TRUST_FRAMEWORKS], [1], [System trust frameworks are available])
+      GNUTLS_LIBS_PRIVATE="${GNUTLS_LIBS_PRIVATE} -framework Security -framework CoreFoundation"
+    ])
   ;;
   *solaris*)
     have_elf=yes
@@ -169,6 +183,7 @@ esac
 AM_CONDITIONAL(ANDROID, test "$have_android" = yes)
 AM_CONDITIONAL(WINDOWS, test "$have_win" = yes)
 AM_CONDITIONAL(MACOSX, test "$have_macosx" = yes)
+AM_CONDITIONAL(SYSTEM_TRUST_FRAMEWORKS, test "$have_system_trust_frameworks" = yes)
 AM_CONDITIONAL(ELF, test "$have_elf" = yes)
 
 dnl Hardware Acceleration
--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -1,4 +1,5 @@
 ## Process this file with automake to produce Makefile.in
+# Modified 2026-11-04: Link available system trust frameworks (LGPL-3.0 incorporating GPL-3.0 section 5(a)).
 # Copyright (C) 2000-2012 Free Software Foundation, Inc.
 #
 # Author: Nikos Mavrogiannopoulos
@@ -241,7 +242,7 @@ defexec_DATA = libgnutls-$(DLL_VERSION).
 DISTCLEANFILES += $(defexec_DATA)
 endif
 
-if MACOSX
+if SYSTEM_TRUST_FRAMEWORKS
 libgnutls_la_LDFLAGS += -framework Security -framework CoreFoundation
 endif
 
--- a/lib/system/certs.c
+++ b/lib/system/certs.c
@@ -1,4 +1,5 @@
 /*
+ * Modified 2026-11-04: Use available system trust APIs (LGPL-2.1 section 2(b)).
  * Copyright (C) 2010-2016 Free Software Foundation, Inc.
  * Copyright (C) 2015-2016 Red Hat, Inc.
  *
@@ -44,7 +45,7 @@
 # endif
 #endif
 
-#ifdef __APPLE__
+#if defined(__APPLE__) && defined(HAVE_SYSTEM_TRUST_FRAMEWORKS)
 # include <CoreFoundation/CoreFoundation.h>
 # include <Security/Security.h>
 # include <Availability.h>
@@ -276,7 +277,7 @@ int add_system_trust(gnutls_x509_trust_l
 
 	return r;
 }
-#elif defined(__APPLE__) && __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
+#elif defined(__APPLE__) && defined(HAVE_SYSTEM_TRUST_FRAMEWORKS) && __MAC_OS_X_VERSION_MIN_REQUIRED >= 1070
 static
 int osstatus_error(status)
 {
